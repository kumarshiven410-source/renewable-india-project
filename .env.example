# Renewable India Intelligence Platform - Environment Configuration
PORT=3000
NODE_ENV=development

# Cache & Sync Configuration
DATA_CACHE_TTL_MINUTES=60
DATA_SYNC_INTERVAL_HOURS=24

# Official Sources Endpoints / Document Repositories
CEA_BASE_URL=https://cea.nic.in
MNRE_BASE_URL=https://mnre.gov.in
DATA_GOV_IN_BASE_URL=https://data.gov.in

# Optional Google Gemini API Key for server-side EcoAI processing
# Note: Keep secret on server side. NEVER commit private keys to GitHub.
GEMINI_API_KEY=

# FastAPI (Python) companion API — does not replace Express.
# Copy backend/.env.example to backend/.env and start with:
#   cd backend && python3 -m venv .venv && source .venv/bin/activate
#   pip install -r requirements.txt && python run.py
# Default URL: http://127.0.0.1:8000
FASTAPI_PORT=8000
