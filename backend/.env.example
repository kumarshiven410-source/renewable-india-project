# FastAPI backend (separate from the Node/Express server on PORT=3000)
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_RELOAD=true
ENVIRONMENT=development

# Absolute or relative path to the shared local JSON fallback directory
# Default: the existing project-root /data folder
DATA_DIR=../data

# CORS: comma-separated origins that may call this API from the browser.
# Express static site runs at http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Cache for local JSON reads (seconds). Official live ingest is not enabled yet.
DATA_CACHE_TTL_SECONDS=60

# Reserved for a later approved MNRE/CEA ingest step. Leave disabled.
ENABLE_OFFICIAL_INGEST=false
CEA_BASE_URL=https://cea.nic.in
MNRE_BASE_URL=https://mnre.gov.in
DATA_GOV_IN_BASE_URL=https://data.gov.in
DATA_GOV_IN_API_KEY=
